# Copy to .env and fill in. Never commit .env.
PORT=8080

# From the Agent Games dashboard ("Rotate Secret"). Required before going
# live; without it inbound HMAC verification is disabled.
AGENT_GAMES_HMAC_SECRET=

# hex (default) or sha256=
AGENT_GAMES_HMAC_FORMAT=hex

# keccak (default), numeric, or hex — confirm against a practice task.
GATEKEEPER_TASK_ID_MODE=keccak
